# Allowlist build inputs. Local data, keys, reports and SearXNG settings are
# excluded rather than copied and removed in a later image layer.
**
!Dockerfile
!.dockerignore
!requirements.lock.txt
!backend/
!backend/**/*.py
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.*
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!deploy/
!deploy/app-entrypoint.py
!deploy/app-healthcheck.py
!deploy/app-backup.py
**/.env
**/.env.*
**/node_modules
**/__pycache__
**/*.pyc
**/*.sqlite*
**/.git
**/evidence
**/data
**/secrets
deploy/searxng/settings.yml
