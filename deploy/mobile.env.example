# Nonsecret mobile-backend example. This file is never a copy of a private .env.
# Review the HTTPS/proxy/allow-host settings before exposing a service.
APP_MODE=mobile
MOBILE_PUBLIC_DATABASE_PATH=data/mobile-public.sqlite3
MOBILE_TASK_TTL_SECONDS=7200
MOBILE_CLEANUP_INTERVAL_SECONDS=5
MOBILE_MAX_TASKS=64
MOBILE_MAX_ACTIVE_TASKS=8
MOBILE_PER_IP_TASKS_PER_MINUTE=6
MOBILE_PER_IP_REQUESTS_PER_MINUTE=120
MOBILE_MAX_IP_BUCKETS=1024
MOBILE_MAX_TOMBSTONES=10000
MOBILE_DAILY_TASKS=200
MOBILE_DAILY_ANALYSIS_CALLS=40
MOBILE_DAILY_MODEL_CALLS=200
MOBILE_DAILY_SEARCH_REQUESTS=1000
MOBILE_DAILY_DETAIL_PAGES=500
MOBILE_DAILY_DETAIL_HTTP=20000
MOBILE_PUBLIC_TTL_SECONDS=604800
MOBILE_PUBLIC_MAX_COURSES=10000
MOBILE_BUDGET_RETENTION_DAYS=31
MOBILE_ORIGINS=https://localhost,capacitor://localhost
TEACHING_MATCH_ENABLED=true
PARALLEL_PLATFORM_SEARCH=true
OPEN_WEB_SEARCH_ENABLED=true
GLOBAL_CONCURRENCY=2
MAX_PENDING_JOBS=20
MAX_SEARCH_REQUESTS=30
MAX_DETAIL_PAGES=40
SEARCH_MAX_RETRIES=0
TASK_DEADLINE_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=6000
JS_RENDER_ENABLED=false
ALLOW_STALE_CACHE=false
SHARED_COURSE_LIBRARY_ENABLED=true
# These safe local defaults do not make the service reachable from a phone.
# A release needs the operator's HTTPS domain and exact trusted host/proxy policy.
LOCAL_ONLY=true
ALLOWED_HOSTS=localhost,127.0.0.1,::1
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PYTHON_DOTENV_DISABLED=1
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
SEARCH_PROVIDER=searxng
SEARXNG_URL=
SEARXNG_FAILOVER_PROVIDER=
TAVILY_ALLOW_KEYLESS=false
BILIBILI_PUBLIC_METADATA=false
PUBLIC_CATALOG_FALLBACK=false
OFFICIAL_SITEMAP_FALLBACK=false
MOOC_GAP_SEARCH_ENABLED=true
MOOC_REFRESH_ENABLED=true
