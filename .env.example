# Copy to .env. All values below are SERVER ONLY. Never prefix secrets with VITE_.
# Default is live. No fixture/demo fallback exists.
SEARCH_PROVIDER=searxng
# Optional platform overrides; empty inherits SEARCH_PROVIDER.
# For independent discovery: BILIBILI_SEARCH_PROVIDER=searxng,
# MOOC_SEARCH_PROVIDER=tavily or serper. Each uses its own server-side key.
BILIBILI_SEARCH_PROVIDER=
MOOC_SEARCH_PROVIDER=
SEARXNG_URL=http://127.0.0.1:18780
# Comma-separated names from YOUR instance /config. Empty = its configured defaults.
# Video-intent queries use video engines, including site-scoped queries; other queries use general engines.
SEARXNG_ENGINES=bing
SEARXNG_VIDEO_ENGINES=duckduckgo videos
# Optional independent engines, attempted once when the first group is empty,
# unrelated, or has no display-eligible course/video link. Only use enabled engines.
# Does not switch paid providers; 401/403/429 at the instance stops the entire request.
SEARXNG_FALLBACK_ENGINES=
# One extra public-index query per point, at most two domains; empty disables it.
# These are search scopes, not seeded courses or overrides of page access rules.
OPEN_COURSE_DOMAINS=ocw.mit.edu,open.edu
# Optional independent official discovery after a normal empty or irrelevant response.
# Default remains searxng; SEARCH_PROVIDER=official_sitemap explicitly selects MIT-only discovery.
# Domain restrictions are preserved. Primary access errors never invoke fallback.
OFFICIAL_SITEMAP_FALLBACK=false
# Optional bounded public HTML catalog discovery; independent video/page evidence is still required.
# No hidden API or fixed project-specific resource list; counts against existing search/detail budgets.
PUBLIC_CATALOG_FALLBACK=false
OFFICIAL_SITEMAP_CACHE_TTL_SECONDS=21600
# Bounded 1..2 child sitemaps per original knowledge point; default 1.
OFFICIAL_SITEMAP_CHILDREN_PER_QUERY=1
# Tavily is used only when selected globally or for a platform.
# Official free, limited keyless search is opt-in. With a key present, the key
# takes precedence and account credits are used. No automatic paid fallback.
TAVILY_ALLOW_KEYLESS=false
TAVILY_API_KEY=
# Optional explicitly configured backup; only quota exhaustion switches keys.
TAVILY_BACKUP_API_KEY=
# Serper trial registration: https://serper.dev/ . Do not put keys in VITE_ variables.
# Explicitly choose MOOC_SEARCH_PROVIDER=serper to use it; no automatic provider fallback.
SERPER_API_KEY=
# Optional shared public course library. Only source-bound full outlines are stored;
# each knowledge point is checked again. No user/project/search-query content is stored.
SHARED_COURSE_LIBRARY_ENABLED=true
SHARED_COURSE_LIBRARY_TTL_SECONDS=604800
SHARED_COURSE_LIBRARY_MAX_CANDIDATES=100
# Stop MOOC queries only after this many distinct courses fully cover the point.
# Bilibili query rounds and the overall task budgets are unchanged.
MOOC_GAP_SEARCH_ENABLED=true
MOOC_TARGET_COURSES_PER_POINT=3
MOOC_GAP_CHECK_WAIT_SECONDS=20
# Backend-only freshness: on a search, refresh a satisfied point once after 24h.
# Uses an existing query slot; no scheduled job, payment or frontend library panel.
MOOC_REFRESH_ENABLED=true
MOOC_REFRESH_INTERVAL_SECONDS=86400
DATABASE_PATH=data/discovery.sqlite3

# Server-only OpenAI-compatible JSON chat service. Project analysis requires it;
# direct knowledge-point search remains available without a model.
LLM_PROVIDER=none
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Missing recommendations: ask the configured model for URLs, then verify their
# public pages. One bounded call per job; no generated titles or claims shown.
AI_VIDEO_FALLBACK_ENABLED=true
# Only used for missing verified videos. Auto uses an already configured
# Serper/Tavily key, otherwise the existing source. Same hard request budget.
AI_VIDEO_SEARCH_PROVIDER=auto

# Fast project recommendations use title/snippet AI relevance and share one
# wall-clock budget across all knowledge points and platforms. Page fetching
# and playback checks are not prerequisites. Historical searches stay readable.
FAST_VIDEO_RECOMMENDATIONS_ENABLED=true
FAST_VIDEO_DEADLINE_SECONDS=110
# Background catalog budgets apply after recommendation completion; no new video search.
CATALOG_BACKGROUND_SECONDS=600
CATALOG_BACKGROUND_MAX_RESOURCES=96
CATALOG_BACKGROUND_MAX_HTTP_REQUESTS=288
CATALOG_BACKGROUND_MAX_MODEL_CALLS=24

MAX_KNOWLEDGE_POINTS=5
MAX_RESULTS_PER_POINT=5
MAX_SEARCH_REQUESTS=30
MAX_DETAIL_PAGES=40
# Two slots allow the enabled Bilibili/MOOC platform lanes to run concurrently.
GLOBAL_CONCURRENCY=2
MAX_PENDING_JOBS=20
SUBMISSION_LIMIT_PER_MINUTE=30
MAX_QUEUE_WAIT_SECONDS=300
TASK_DEADLINE_SECONDS=180
# Project search reserves each batch's full task budget before any search starts.
# These totals do not change the per-task cap, source pauses or global admission.
PROJECT_MAX_BATCHES=6
PROJECT_MAX_SEARCH_REQUESTS=180
PROJECT_MAX_DETAIL_PAGES=240
PROJECT_DEADLINE_SECONDS=1800
SEARCH_TIMEOUT_SECONDS=12
SEARCH_MAX_RETRIES=1
SEARCH_MIN_INTERVAL_SECONDS=1
SEARCH_RESULTS_PER_QUERY=6
SEARCH_CACHE_TTL_SECONDS=21600
PAGE_CACHE_TTL_SECONDS=86400
ALLOW_STALE_CACHE=false
FETCH_ENABLED=true
# Opt in for local use: anonymous Bilibili video-page metadata and multipart
# titles. Robots, access gates, request limits and SSRF checks still apply.
BILIBILI_PUBLIC_METADATA=false
FETCH_TIMEOUT_SECONDS=8
FETCH_MIN_INTERVAL_MS=500
# Optional phased transport; partial bodies never become course evidence.
FETCH_PHASED_TIMEOUTS=false
FETCH_BODY_IDLE_TIMEOUT_SECONDS=5
FETCH_BODY_MIN_BYTES_PER_SECOND=32768
FETCH_BODY_TIMEOUT_CAP_SECONDS=20
# Optional offline DOM enrichment, using only Fetcher-approved resource bytes.
JS_RENDER_ENABLED=false
JS_RENDER_ALLOWED_HOSTS=
# Optional exact HTTPS course entry restriction; e.g. https://microsoft.github.io/AI-For-Beginners/
JS_RENDER_ALLOWED_ENTRIES=
JS_RENDER_ASSET_HOSTS=
JS_RENDER_TIMEOUT_SECONDS=20
JS_RENDER_MAX_RESOURCES=6
# Additional per-render requests, including asset robots/redirects; not a job total.
JS_RENDER_MAX_TARGET_REQUESTS=12
JS_RENDER_MAX_DOH_REQUESTS=24
JS_RENDER_MAX_TOTAL_BYTES=2000000
JS_RENDER_MAX_DOM_BYTES=1000000
JS_RENDER_SETTLE_MS=500
JS_RENDER_MAX_OBSERVED_DATA_RESOURCES=2
# system is default. Optional cloudflare_doh uses fixed trusted public DNS/TLS
# when a local Fake-IP DNS returns nonpublic answers; all destination guards stay on.
DNS_RESOLVER=system
# Unreviewed platforms are search-discovery only. Only add a hostname after
# checking its rules/authorization. This list cannot override known permission
# requirements (e.g. Bilibili and YouTube). robots/SSRF checks still apply.
ALLOWED_RESTRICTED_HOSTS=
# Exact host/domain stops after an observed denial or a deployment-specific restriction.
DENIED_FETCH_HOSTS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Single-user loopback deployment. External access requires authenticated proxy review.
LOCAL_ONLY=true
ALLOWED_HOSTS=localhost,127.0.0.1,::1
MAX_REQUEST_BODY_BYTES=512000
REQUEST_BODY_TIMEOUT_SECONDS=10
API_WRITE_LIMIT_PER_MINUTE=60
MAX_PENDING_ANALYSES=8
MAX_PENDING_PROJECT_SEARCHES=20
# Global open SSE subscriptions; idle/disconnected streams release their slot.
MAX_EVENT_STREAMS=16
# Compact project analysis: one generation, optional repair for local errors.
# Queue + generation + validation + optional repair share at most 60 seconds.
# Legacy larger settings remain readable but runtime clamps them to 60 seconds.
PROJECT_ANALYSIS_TIMEOUT_SECONDS=60
PROJECT_ANALYSIS_TOTAL_TIMEOUT_SECONDS=60
# Historical compatibility only; neither value starts an independent reviewer.
PROJECT_SEMANTIC_REVIEW_ENABLED=false
# Shared JSON calls keep their own model/thinking/output settings.
LLM_MAX_OUTPUT_TOKENS=6000
# Project-only reasoning: inherit supports other providers; low opts into
# enabled/low on the documented official HTTPS DeepSeek endpoint only.
# Search, ranking and course matching retain their existing global options.
PROJECT_ANALYSIS_REASONING_EFFORT=inherit
# Optional project-only model; empty inherits LLM_MODEL. This installation uses
# deepseek-flash with low reasoning as the v24 baseline; other providers inherit.
PROJECT_ANALYSIS_MODEL=
# Opt-in low generation allowance, including reasoning and answer (256..16000).
PROJECT_ANALYSIS_MAX_OUTPUT_TOKENS=8000
# Optional repair allowance (legacy setting name); no mandatory second call.
PROJECT_ANALYSIS_NORMALIZATION_MAX_OUTPUT_TOKENS=8000
# auto selects low only for documented official DeepSeek models when thinking remains enabled.
# provider_default leaves the provider setting unchanged; other providers need an explicit supported value.
LLM_REASONING_EFFORT=auto
# auto disables thinking for documented official DeepSeek models in shared JSON tasks;
# project analysis changes this only through the explicit project opt-in above.
# provider_default leaves the upstream mode unchanged; explicit enabled/disabled requires provider support.
LLM_THINKING_MODE=auto

# Explicit learning-skill matching: 0 disables business model judgement.
# Each job allows 0-2 matching calls (15s / <=3000 output tokens each),
# plus at most one mandatory positive-claim review (15s / <=1500 tokens).
# All calls share the existing job deadline; GET/history never calls a model.
TEACHING_MATCH_MAX_CALLS_PER_JOB=2
# Optional legacy explicit-skill matching is disabled for this discovery flow.
# Confirmed professional names are searched without injected learning-skill axes.
TEACHING_MATCH_ENABLED=false
# Each selected platform gets one query per point before any retry/supplement.
# Search allowance = selected points * sum(selected platform rounds), capped by
# MAX_SEARCH_REQUESTS. Additional rounds use complementary queries, with one
# transient-failure retry in round two. Rate limits/access denials still stop the
# affected source. Project batches finish every initial pass before followups.
# Defaults are 2 rounds each; optional MOOC rounds 7-10 use narrower public
# course queries while preserving every original matching obligation. Bilibili
# remains bounded at 6 rounds. A larger configuration is B=3 / MOOC=10,
# MAX_SEARCH_REQUESTS=80, MAX_DETAIL_PAGES=60, SEARCH_RESULTS_PER_QUERY=12.
# For six batches also allow PROJECT_MAX_SEARCH_REQUESTS=480 and
# PROJECT_MAX_DETAIL_PAGES=360. These are caps, not a promise of usable courses.
PARALLEL_PLATFORM_SEARCH=true
# One unrestricted initial query per point, alongside the selected platforms.
# Uses the same MAX_SEARCH_REQUESTS cap; insufficient first-pass budget is rejected.
OPEN_WEB_SEARCH_ENABLED=true
BILIBILI_SEARCH_ROUNDS=2
MOOC_SEARCH_ROUNDS=2
